{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nchef-api",
  "account_id": "5461025e548c01fea04a40b509473036",
  "compatibility_date": "2026-10-14",
  "main": "worker/index.mjs",
  "workers_dev": false,
  "assets": { "directory": "./dist/site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "observability": { "enabled": true, "logs": { "enabled": true }, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nchef-db",
      "database_id": "cdd61c50-94ca-4978-a588-8dce8ceacdc1",
      "migrations_dir": "migrations"
    }
  ]
}
