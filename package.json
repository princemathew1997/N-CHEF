{
  "name": "nchef-kitchen-stock-tracker",
  "version": "2.3.0",
  "description": "Commercial multi-outlet kitchen inventory management, cuisine sections indents & stock tracking platform.",
  "main": "js/app.js",
  "scripts": {
    "start": "npm run build && wrangler dev --port 8000 --ip 127.0.0.1",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:database": "python -m unittest discover -s tests -v",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "release:check": "node scripts/release.mjs check",
    "release:deploy": "node scripts/release.mjs deploy",
    "release:rollback": "node scripts/release.mjs rollback"
  },
  "keywords": [
    "kitchen-management",
    "restaurant-inventory",
    "cuisine-sections",
    "stock-tracker",
    "indents"
  ],
  "license": "ISC",
  "devDependencies": {
    "acorn": "^8.19.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261012.0-beta",
    "wrangler": "4.151.0"
  }
}
